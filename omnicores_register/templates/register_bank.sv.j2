              {% if not first %}else {% endif %}if § (register__{{register.hierarchical_name}}__{{field.name}}__hw_clear_all) § register__{{register.hierarchical_name}}__{{field.name}}__storage § <= { {{field.width}} {1'b0} };
              {%- set first = false %}
