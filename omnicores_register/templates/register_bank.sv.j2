                    {§ align §} {{file_name}} {§ align §} <= {{negate}}control__pwdata {§ align §} [{{field.offset+field.width-1}}:{{field.offset}}] {§ align right §} {{mask}}; {{"end" if loop.last else "\n {§ align §} "}}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif %}
            {%- else %}
