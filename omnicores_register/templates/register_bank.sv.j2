                      {%- set negate = "" -%}
                      {%- set mask = " ^ " ~ file_name -%}
                    {%- elif field.sw_write_behavior == SoftwareWriteBehavior.WRITE_ZERO_SETS -%}
                      {%- set negate = "~" -%}
                      {%- set mask = " | " ~ file_name -%}
                    {%- elif field.sw_write_behavior == SoftwareWriteBehavior.WRITE_ZERO_CLEARS -%}
