              {%- endif %}
              {%- set first = false %}
            {%- endif %}
            {%- if field.has_hw_write_option(HardwareWriteOptions.INCREMENT) %}
              {% if not first %}else {% endif %}if § (register__{{register.hierarchical_name}}__{{field.name}}__hw_increment) § register__{{register.hierarchical_name}}__{{field.name}}__storage § <= register__{{register.hierarchical_name}}__{{field.name}}__storage + 1;
              {%- set first = false %}
            {%- endif %}
            {%- if field.has_hw_write_option(HardwareWriteOptions.DECREMENT) %}
