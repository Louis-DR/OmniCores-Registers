                {%- set negation  = " " -%}
                {%- set operation = "^" -%}
              {%- elif register.sw_write_behavior == SoftwareWriteBehavior.WRITE_ZERO_SETS -%}
                {%- set negation  = "~" -%}
                {%- set operation = "|" -%}
              {%- elif register.sw_write_behavior == SoftwareWriteBehavior.WRITE_ZERO_CLEARS -%}
                {%- set negation  = " " -%}
                {%- set operation = "&" -%}
              {%- elif register.sw_write_behavior == SoftwareWriteBehavior.WRITE_ZERO_TOGGLES -%}
                {%- set negation  = "~" -%}
                {%- set operation = "^" -%}
              {%- endif %}
              register__{{register.hierarchical_name}}__storage <= {{negation}}control__pwdata [{{register.width-1}}:0] {{operation}} register__{{register.hierarchical_name}}__storage;
            {%- endif %}
            register__{{register.hierarchical_name}}__written <= 1'b1;
          end
        end
        {%- endif %}
        {%- endfor %}
      endcase
{% endif %} {#- register_bank.has_sw_write_once #}
    end

    {§ spacing 1 §}

    // Hardware write
    {%- filter align %}
    {%- filter reindent(2) %}
      {%- for register in register_bank.registers %}
        {%- if register.fields %} {%- for field in register.fields %}
          {%- if field.is_hardware_writable() %}
            {%- set first = true %}
            {%- if field.has_hw_write_option(HardwareWriteOptions.ENABLE) %}
              if § (register__{{register.hierarchical_name}}__{{field.name}}__hw_write_enable) § register__{{register.hierarchical_name}}__{{field.name}}__storage § <= register__{{register.hierarchical_name}}__{{field.name}}__hw_write_data;
