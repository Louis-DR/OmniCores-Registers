// ║ Description: Generated register bank containing the register storage and  ║
// ║              software and hardware access logic.                          ║
// ╚═══════════════════════════════════════════════════════════════════════════╝



{% filter restructure %}
module {{register_bank.name}}__register_bank (
{% filter remove_blank_lines -%}
{% filter remove_last_comma -%}
{% filter autoformat_module_ports %}

  // Control interface
  input  logic        control__pclock,
  input  logic        control__preset_n,
  input  logic        control__psel,
  input  logic        control__penable,
  output logic        control__pready,
  input  logic [31:0] control__paddr,
  input  logic        control__pwrite,
  input  logic [31:0] control__pwdata,
  output logic [31:0] control__prdata,

  // Registers
  {%- for register in register_bank.registers %}
  {%- if register.fields %} {%- for field in register.fields %}
  {%- if field.is_hardware_readable() %}
  output logic {{field.width|arr}} register__{{register.name}}__{{field.name}},
  {%- endif %} {#- field.is_hardware_readable #}
  {%- if field.is_hardware_writable() %}
  input  logic                     register__{{register.name}}__{{field.name}}__hw_write_enable,
  input  logic {{field.width|arr}} register__{{register.name}}__{{field.name}}__hw_write_data,
  {%- endif %} {#- field.is_hardware_writable #}
  {%- endfor %} {%- else %} {#- fields #}
  {%- if register.is_hardware_readable() %}
  output logic {{register.width|arr}} register__{{register.name}},
  {%- endif %} {#- register.is_hardware_readable #}
  {%- if register.is_hardware_writable() %}
  input  logic                        register__{{register.name}}__hw_write_enable,
  input  logic {{register.width|arr}} register__{{register.name}}__hw_write_data,
  {%- endif %} {#- register.is_hardware_writable #}
  {%- endif %} {#- fields #}
  {%- endfor %} {#- registers #}

{%- endfilter %} {#- autoformat_module_ports #}
{%- endfilter %} {#- remove_last_comma #}
{%- endfilter %} {#- remove_blank_lines #}
);



  {§ spacing 3 §}



  // Registers and fields storage
  {%- filter autoformat_signal_definitions %}
  {% for register in register_bank.registers %}
  {%- if register.fields %} {%- for field in register.fields %}
  logic {{field.width|arr}} register__{{register.name}}__{{field.name}}__storage;
  {%- endfor %} {%- else %} {#- fields #}
  logic {{register.width|arr}} register__{{register.name}}__storage;
  {%- endif %} {#- fields #}
  {%- endfor %} {#- registers #}
  {%- endfilter %} {#- autoformat_signal_definitions #}



  {§ spacing 3 §}



  // Reset and write
  always_ff @(posedge control__pclock or negedge control__preset_n) begin

    {§ spacing 1 §}

    // Reset
    if (!control__preset_n) begin
      {%- filter align %}
      {%- for register in register_bank.registers %}
      {%- if register.fields %} {%- for field in register.fields %}
      {%- if field.reset_value is not none %}
      register__{{register.name}}__{{field.name}}__storage § <= § {{field.width}}'h{{field.reset_value|hexadecimal}}; §§
      {%- endif %} {#- field.reset_value #}
      {%- endfor %} {%- else %} {#- fields #}
      {%- if register.reset_value is not none %}
      register__{{register.name}}__storage § <= § {{register.width}}'h{{register.reset_value|hexadecimal}}; §§
      {%- endif %} {#- register.reset_value #}
      {%- endif %} {#- fields #}
      {%- endfor %} {#- registers #}
      {%- endfilter %} {#- align #}
    end

    {§ spacing 1 §}

    // Software write
    else if (   control__psel
             && control__penable
             && control__pwrite ) begin
      case (control__paddr)
        {%- filter align %}
        {%- for register in register_bank.registers %}
        {%- if register.fields %}
        {%- if register.is_software_writable() %}
        32'h{{register.address|hexadecimal}} § : begin {%- for field in register.fields -%} {%- if field.is_software_writable() %} § register__{{register.name}}__{{field.name}}__storage § <= control__pwdata § [{{field.offset+field.width-1}}:{{field.offset}}]; §§ {{"end" if loop.last else "\n § "}} {%- endif -%} {%- endfor -%}
        {%- endif %} {#- register.is_software_writable #}
        {%- else %} {#- fields #}
        {%- if register.is_software_writable() %}
        32'h{{register.address|hexadecimal}} § : § register__{{register.name}}__storage § <= control__pwdata § [{{register.width-1}}:0]; §§
        {%- endif %} {#- register.is_software_writable #}
        {%- endif %} {#- fields #}
        {%- endfor %} {#- registers #}
        {%- endfilter %} {#- align #}
      endcase
    end

    {§ spacing 1 §}

    // Hardware write
    {%- filter align %}
    {%- for register in register_bank.registers %}
    {%- if register.fields %} {%- for field in register.fields %}
    {%- if field.is_hardware_writable() %}
    if (register__{{register.name}}__{{field.name}}__hw_write_enable) § register__{{register.name}}__{{field.name}}__storage § <= register__{{register.name}}__{{field.name}}__hw_write_data;
    {%- endif %} {#- field.is_hardware_writable #}
    {%- endfor %} {%- else %} {#- fields #}
    {%- if register.is_hardware_writable() %}
    if (register__{{register.name}}__hw_write_enable) § register__{{register.name}}__storage § <= register__{{register.name}}__hw_write_data;
    {%- endif %} {#- register.is_hardware_writable #}
    {%- endif %} {#- fields #}
    {%- endfor %} {#- registers #}
    {%- endfilter %} {#- align #}

    {§ spacing 1 §}

  end



  {§ spacing 3 §}



  // Software response and read
  always_comb begin
    if (   control__psel
        && control__penable ) begin

      {§ spacing 1 §}

      // Software response
      control__pready  = 1'b1;

      {§ spacing 1 §}

      // Software read
      if (!control__pwrite) begin
        control__prdata  = 32'd0;
        case (control__paddr)
          {%- filter align %}
          {%- for register in register_bank.registers %}
          {%- if register.fields %}
          {%- if register.is_software_readable() %}
          32'h{{register.address|hexadecimal}} § : begin {%- for field in register.fields -%} {%- if field.is_software_readable() %} § control__prdata § [{{field.offset+field.width-1}}:{{field.offset}}] §§ = register__{{register.name}}__{{field.name}}__storage; {{"end" if loop.last else "\n § "}} {%- endif -%} {%- endfor -%}
          {%- endif %} {#- field.is_software_readable #}
          {%- else %} {#- fields #}
          {%- if register.is_software_readable() %}
          32'h{{register.address|hexadecimal}} § : § control__prdata § [{{register.width-1}}:0] §§ = register__{{register.name}}__storage;
          {%- endif %} {#- register.is_software_readable #}
          {%- endif %} {#- fields #}
          {%- endfor %} {#- registers #}
          {%- endfilter %} {#- align #}
          default: begin
            control__prdata  = 32'd0;
          end
        endcase
      end
    end

    {§ spacing 1 §}

    // Bus return to zero
    else begin
      control__pready  =  1'b0;
      control__prdata  = 32'd0;
    end

    {§ spacing 1 §}

  end



  {§ spacing 3 §}



  // Hardware read
  {%- filter align -%}
  {%- for register in register_bank.registers %}
  {%- if register.fields %} {%- for field in register.fields %}
  assign register__{{register.name}}__{{field.name}} § = register__{{register.name}}__{{field.name}}__storage;
  {%- endfor %} {%- else %} {#- fields #}
  assign register__{{register.name}} § = register__{{register.name}}__storage;
  {%- endif %} {#- fields #}
  {%- endfor %} {#- registers #}
  {%- endfilter %} {#- align #}



  {§ spacing 3 §}



endmodule
{% endfilter %}
