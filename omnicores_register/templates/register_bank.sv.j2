              if § (register__{{register.hierarchical_name}}__hw_write_enable) § register__{{register.hierarchical_name}}__storage § <= register__{{register.hierarchical_name}}__hw_write_data;
              {%- set first = false %}
            {%- endif %}
            {%- if register.has_hw_write_option(HardwareWriteOptions.CONTINUOUS) %}
              else § § register__{{register.hierarchical_name}}__storage § <= register__{{register.hierarchical_name}}__hw_write_data;
              {%- set first = false %}
            {%- endif %}
            {%- if register.has_hw_write_option(HardwareWriteOptions.SET_MASK) %}
              {% if not first %}else {% endif %}if § (|register__{{register.hierarchical_name}}__hw_set_mask) § register__{{register.hierarchical_name}}__storage § <= register__{{register.hierarchical_name}}__storage | register__{{register.hierarchical_name}}__hw_set_mask;
              {%- set first = false %}
            {%- endif %}
            {%- if register.has_hw_write_option(HardwareWriteOptions.SET_ALL) %}
              {% if not first %}else {% endif %}if § (register__{{register.hierarchical_name}}__hw_set_all) § register__{{register.hierarchical_name}}__storage § <= { {{register.width}} {1'b1} };
              {%- set first = false %}
            {%- endif %}
            {%- if register.has_hw_write_option(HardwareWriteOptions.CLEAR_MASK) %}
              {% if not first %}else {% endif %}if § (|register__{{register.hierarchical_name}}__hw_clear_mask) § register__{{register.hierarchical_name}}__storage § <= register__{{register.hierarchical_name}}__storage & ~register__{{register.hierarchical_name}}__hw_clear_mask;
              {%- set first = false %}
            {%- endif %}
            {%- if register.has_hw_write_option(HardwareWriteOptions.CLEAR_ALL) %}
              {% if not first %}else {% endif %}if § (register__{{register.hierarchical_name}}__hw_clear_all) § register__{{register.hierarchical_name}}__storage § <= { {{register.width}} {1'b0} };
              {%- set first = false %}
            {%- endif %}
