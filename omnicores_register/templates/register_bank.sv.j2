            {%- endif %}
            {%- if field.is_software_write_once() %}
              register__{{register.hierarchical_name}}__{{field.name}}__written § <= § 1'b0; §§
            {%- endif %}
          {%- endfor %} {%- else %}
            {%- if register.reset_value is not none %}
              register__{{register.hierarchical_name}}__storage § <= § {{register.width}}'h{{register.reset_value|hexadecimal((register.width/4)|ceil)}}; §§
            {%- endif %}
